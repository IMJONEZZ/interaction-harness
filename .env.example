# interaction-harness settings. Copy to .env (or export the variables) and fill in what you use.
# Every model role is any OpenAI-compatible endpoint: <ROLE>_BASE_URL, <ROLE>_API_KEY, <ROLE>_MODEL.
# A key is only ever sent to the host it was set for.

# --- FOREGROUND: holds the conversation, calls quick tools, hands off hard work, judges end-of-turn --------
# Required. Falls back to OPENAI_BASE_URL / OPENAI_API_KEY when these are unset.
FOREGROUND_BASE_URL=http://127.0.0.1:8080/v1
FOREGROUND_API_KEY=
# Blank: the first model the server lists.
FOREGROUND_MODEL=
# How this server switches thinking: chat_template_kwargs (vLLM, llama.cpp, SGLang) | reasoning_effort | off
FOREGROUND_THINKING=chat_template_kwargs

# --- BACKGROUND: works on handed-off tasks with thinking on, browses, reports back on its own ---------------
# Blank: the foreground's server and model (field by field).
BACKGROUND_BASE_URL=
BACKGROUND_API_KEY=
BACKGROUND_MODEL=
BACKGROUND_THINKING=
BACKGROUND_TEMPERATURE=0.7
# Model calls per background task
BACKGROUND_ROUNDS=10

# --- ASR: speech -> text (POST /audio/transcriptions) ------------------------------------------------------
# Blank or "local": Parakeet TDT 0.6B v3 in-process (MLX on Apple Silicon, ONNX elsewhere).
ASR_BASE_URL=
ASR_API_KEY=
# Endpoint: the server's transcription model. In-process: override the Parakeet model id.
ASR_MODEL=
ASR_LANGUAGE=
# Partial transcripts every N ms while you talk; 0 = only when the end-of-turn judge needs one.
# On an endpoint each partial is one request.
ASR_PARTIAL_MS=640

# --- TTS: text -> speech (POST /audio/speech) --------------------------------------------------------------
# Blank or "local": Kokoro-82M in-process (MLX on Apple Silicon, ONNX elsewhere).
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# Blank: af_heart in-process, else the first voice the server lists (required if the server lists none).
TTS_VOICE=
# Comma-separated voices for the dashboard's picker, if the server does not list them.
TTS_VOICES=
# Endpoint audio: wav (default) or pcm; with pcm, the server's sample rate.
TTS_FORMAT=wav
TTS_SAMPLE_RATE=24000
TTS_SPEED=1.05

# --- DUPLEX (optional): a full-duplex speech model for the dashboard's Full-duplex mode (docs/duplex.md) --------
# e.g. ws://127.0.0.1:8770/v1 from `interaction-harness duplex-server`. Blank: the mode is off.
DUPLEX_BASE_URL=
DUPLEX_API_KEY=
# Blank: the one model the server lists
DUPLEX_MODEL=

# --- in-process speech --------------------------------------------------------------------------------------
# auto (mlx on Apple Silicon, onnx elsewhere) | mlx | onnx
BACKEND=auto
# onnx backend: cpu | cuda (needs the onnx-gpu extra)
DEVICE=cpu
# onnx model variants: PARAKEET fp32|int8, KOKORO fp32|fp16|int8
PARAKEET_ONNX_VARIANT=int8
KOKORO_ONNX_VARIANT=int8

# --- everything else ----------------------------------------------------------------------------------------
# Comma-separated Python files of @tool functions
TOOLS=
# A directory to keep a WAV of every user turn the ASR heard (debugging)
SAVE_UTTERANCES=
HOST=127.0.0.1
PORT=8765
# HTTPS, so a browser on another machine may use the microphone
SSL_CERTFILE=
SSL_KEYFILE=
# Prompt overrides (easier in interaction-harness.toml under [prompts])
# FOREGROUND_PROMPT=
# BACKGROUND_PROMPT=
# END_OF_TURN_PROMPT=
# DUPLEX_PROMPT=
